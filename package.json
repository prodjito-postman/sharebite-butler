{
  "name": "sharebite-butler",
  "version": "0.1.0",
  "type": "module",
  "description": "A personal chat agent that plans, places, and cancels your daily Sharebite lunch orders, optimizing for past preference, value, and the day's allowance.",
  "scripts": {
    "dev": "bun --watch agent/index.ts",
    "dev:ingest": "bun --watch ingestion/manual/index.ts",
    "start": "bun agent/index.ts",
    "ingest": "bun ingestion/manual/index.ts",
    "recommend": "bun agent/cli.ts"
  },
  "main": "./agent/index.ts",
  "dependencies": {
    "@astropods/adapter-mastra": "latest",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/memory": "latest",
    "@mastra/observability": "latest",
    "@mastra/otel-exporter": "latest",
    "@opentelemetry/exporter-trace-otlp-proto": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.9.3"
  }
}
